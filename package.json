{
  "name": "tractor-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fünf deutsche Extraktions-Demos für tractor, das System One Extraction Model",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js",
    "probe": "node --env-file-if-exists=.env scripts/probe.mjs"
  }
}
