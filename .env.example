# Basis-URL eures tractor-Servers (tractor serve), ohne /v1/extract.
# Leer lassen = Datenvorschau, keine Modellaufrufe.
# Läuft tractor auf dem Docker-Host: http://host.docker.internal:8000
TRACTOR_URL=

# Optionaler Ressourcensatz in Währungseinheiten pro Stunde für die Kostenanzeige. Leer = unbekannt.
TRACTOR_COST_PER_HOUR=

# Optionaler Vergleich mit einem LLM über /v1/chat/completions mit striktem JSON-Schema.
# Ohne LLM_MODEL und LLM_API_KEY bleibt der Vergleich gesperrt.
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=
LLM_API_KEY=
# Listenpreise je 1 Mio. Token (beide nötig). Ohne beide keine Kostenangabe für das LLM.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_PRICE_NOTE=
COST_CURRENCY=EUR

HOST=127.0.0.1
PORT=3000
REQUEST_TIMEOUT_MS=60000
# tractor arbeitet mit einem Worker pro Prozess; mehr parallele Anfragen werden eingereiht.
MAX_CONCURRENCY=1

DEMO_BIND_ADDRESS=127.0.0.1
DEMO_PORT=3000
